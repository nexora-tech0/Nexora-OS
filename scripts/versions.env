# Nexora OS pinned toolchain and third-party versions.
# Single source of truth: sourced by scripts/*.sh (POSIX sh) and included by the Makefile.
# Keep plain KEY=value lines (no quotes, no spaces) so both sh and make can read it.

# LLVM/Clang/LLD (official release tarball, glibc x86-64)
LLVM_VERSION=22.1.8
LLVM_MAJOR=22
LLVM_TARBALL=LLVM-22.1.8-Linux-X64.tar.xz
LLVM_SHA256=df0e1ecf16caf3489a272a5eea4eec9b0d82878f6477fa309504f918a0006384

# Rust (stable), kernel target
RUST_VERSION=1.98.1
RUST_KERNEL_TARGET=x86_64-unknown-none

# Limine bootloader (binary branch tag + the commit it must dereference to, i.e. tag^{})
LIMINE_TAG=v11.4.1-binary
LIMINE_COMMIT=5be26a73d7b7b4d4477d18be94e1d16e615adf56

# Vendored sources (already committed under third_party/; recorded here for provenance)
LIMINE_PROTOCOL_COMMIT=3a0526b700e356f0eac1b71a77697b3fd1c707a3
STB_COMMIT=2c980bb59875b0d32144a71867fbdebb2f77cd20
INTER_VERSION=4.1
